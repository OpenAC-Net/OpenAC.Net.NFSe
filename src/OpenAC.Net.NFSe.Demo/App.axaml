<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenAC.Net.NFSe.Demo.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2563EB" RegionColor="#F3F7FE" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://OpenAC.Net.NFSe.Demo/Styles/BlueTheme.axaml" />
    </Application.Styles>
</Application>